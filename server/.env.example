# Copy this file to .env and fill in your values.
# .env is never committed to git.

# PostgreSQL connection string (required for persistence & version history)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/collab_editor

# Port the Express/Socket.io server listens on
PORT=3001

# URL of the frontend (used for CORS)
CLIENT_ORIGIN=http://localhost:5173
