# Copy this file to .env and fill in your values

# PostgreSQL connection string from RDS
DATABASE_URL=postgresql://postgres:YOURPASSWORD@YOUR-RDS-ENDPOINT:5432/collabeditor

# The CloudFront URL of your deployed client (no trailing slash)
CLIENT_ORIGIN=https://YOURXXXXX.cloudfront.net

# Port the server listens on (EC2 security group must allow this)
PORT=3001
